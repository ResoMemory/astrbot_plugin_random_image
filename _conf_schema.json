{
    "max_count": {
        "description": "单次最多发送图片数量",
        "type": "int",
        "default": 15,
        "hint": "建议不超过 20"
    },
    "default_count": {
        "description": "默认发送图片数量",
        "type": "int",
        "default": 1,
        "hint": "不填数量时发送的张数"
    },
    "orientation": {
        "description": "图片方向偏好",
        "type": "string",
        "default": "random",
        "enum": ["random", "pc", "pe"],
        "hint": "random=随机, pc=横屏, pe=竖屏"
    },
    "api_timeout": {
        "description": "API 请求超时时间（秒）",
        "type": "int",
        "default": 10,
        "hint": "网络慢时可适当调大"
    },
    "headers_json": {
        "description": "请求头（JSON 格式字符串）",
        "type": "string",
        "default": "{\"User-Agent\": \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36\", \"Accept\": \"application/json\"}",
        "hint": "输入 JSON 对象，如 {\"User-Agent\": \"...\"}"
    }
}
